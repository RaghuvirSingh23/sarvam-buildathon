# Copy to .env for local use, and add the same keys in Vercel
# (Project Settings -> Environment Variables). Never commit real values.

# Sarvam (server-side only; used by upcoming /api endpoints)
SARVAM_API_KEY=

# Telegram (optional / future)
TELEGRAM_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service role / secret key — SERVER ONLY. Never expose to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
